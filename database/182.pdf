         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">LncGSEA: a versatile tool to infer lncRNA associated pathways from large-scale cancer transcriptome sequencing data</rdf:li>
            </rdf:Alt>
         </dc:title>
